
<div class="container-fluid py-2">
  <h1 class="mb-4 fw-bold">📊 Financial Overview Widgets
    <span class="fs-5 text-muted fw-bold  ms-2"> Today: (<%= @current_date %>)</span>
  </h1>

  <div class="row g-3">

    <div class="col-12 col-sm-6 col-md-3">
      <div class="card h-100 border-0 shadow-sm bg-danger-subtle text-dark">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="card-title text-dark-50 mb-0">📌 ยอดขายรวม (Total Sales)</h6>
            <i class="bi bi-currency-dollar fs-4"></i>
          </div>
          <h3 class="fw-bold mb-1"><%= number_to_currency(@total_sales_today, unit: "฿", precision: 2) %></h3>
          <p class="mb-0 small">
            <% if @sales_growth_percentage >= 0 %>
              <span class="text-success">↑ +<%= @sales_growth_percentage %>%</span> เปรียบเทียบกับเมื่อวาน
            <% else %>
              <span class="text-warning-50">↓ <%= @sales_growth_percentage %>%</span> เปรียบเทียบกับเมื่อวาน
            <% end %>
          </p>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-md-3">
      <div class="card h-100 border-0 shadow-sm bg-success text-dark">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="card-title text-dark-50 mb-0">📌 จำนวนออเดอร์ (Total Orders)</h6>
            <i class="bi bi-cart-check fs-4"></i>
          </div>
          <h3 class="fw-bold mb-1"><%= @total_orders_today %> บิล</h3>
          <p class="mb-0 text-dark-50 small">ออเดอร์ขายหน้าร้านที่สำเร็จ</p>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-md-3">
      <div class="card h-100 border-0 shadow-sm bg-warning text-dark">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="card-title text-muted mb-0 fw-bold">📌 กำไรขั้นต้น (Gross Profit)</h6>
            <i class="bi bi-graph-up-arrow fs-4 text-dark"></i>
          </div>
          <h3 class="fw-bold mb-1"><%= number_to_currency(@gross_profit_today, unit: "฿", precision: 2) %></h3>
          <p class="mb-0 text-muted small">ยอดขายหักต้นทุนสินค้าแล้ว</p>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-md-3">
      <div class="card h-100 border-0 shadow-sm bg-dark text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="card-title text-white-50 mb-0">📌 มูลค่าสินค้าคงคลังสุทธิ (Inventory Value)</h6>
            <i class="bi bi-box-seam fs-4"></i>
          </div>
          <h3 class="fw-bold mb-1"><%= number_to_currency(@inventory_value, unit: "฿", precision: 2) %></h3>
          <p class="mb-0 text-white-50 small">เงินทุนรวมทั้งหมดที่จมในสต็อก</p>
        </div>
      </div>
    </div>
</div> </div>

<hr>

<div class="row mt-0 g-4">

  <div class="col-12 col-md-6">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-danger">
          <i class="bi bi-exclamation-triangle-fill me-2"></i> 🚨Low Stock Alerts
        </h5>
        <span class="badge bg-danger rounded-pill"><%= @low_stock_products.count %> Items</span>
      </div>
      <div class="card-body pt-0">
        <% if @low_stock_products.any? %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Product</th>
                  <th class="text-center">Stock Balance</th>
                  <th class="text-end">Management</th>
                </tr>
              </thead>
              <tbody>
                <% @low_stock_products.each do |product| %>
                  <tr>
                    <td class="fw-semibold"><%= product.name %></td>
                    <td class="text-center">
                      <span class="badge bg-light text-danger fw-bold fs-6 border border-danger">
                        <%= product.quantity %> pcs.
                      </span>
                    </td>
                    <td class="text-end">
                      <%= link_to new_inbound_order_path(product_id: product.id), class: "btn btn-sm btn-outline-primary" do %>
                        <i class="bi bi-plus-circle me-1"></i>Order Now
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-4 text-muted">
            <i class="bi bi-check-circle-fill text-success fs-1 mb-2"></i>
            <p class="mb-0">สต็อกสินค้าทุกชิ้นยังปลอดภัยดี!</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-6">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-header bg-white border-0 py-3">
        <h5 class="mb-0 fw-bold text-dark">
          <i class="bi bi-clock-history me-2 text-warning"></i>🚨 Pending Inbound/Outbound
        </h5>
      </div>
      <div class="card-body d-flex flex-column justify-content-center gap-3">

        <div class="p-3 rounded-3 bg-light border-start border-warning border-4 d-flex justify-content-between align-items-center">
          <div>
            <h6 class="fw-bold mb-1 text-warning-dark">บิลรับเข้าสินค้า (Inbound) ค้างตรวจสอบ</h6>
            <p class="mb-0 text-muted small">มีสินค้าที่ยังไม่ได้กดรับเข้าสต็อกสำเร็จ</p>
          </div>
          <div class="text-end">
            <h4 class="fw-bold text-warning mb-1"><%= @pending_inbound_count %> บิล</h4>
            <%= link_to "ไปเคลียร์บิล", inbound_orders_path, class: "btn btn-xs btn-warning text-dark fw-semibold py-1 px-2 fs-7" %>
          </div>
        </div>

        <div class="p-3 rounded-3 bg-light border-start border-info border-4 d-flex justify-content-between align-items-center">
          <div>
            <h6 class="fw-bold mb-1 text-info-dark">ออเดอร์ขาย (Outbound) ค้างชำระ/ค้างส่ง</h6>
            <p class="mb-0 text-muted small">บิลขายหน้าร้านที่ยังปิดไม่ลง หรือรอเงินเข้า</p>
          </div>
          <div class="text-end">
            <h4 class="fw-bold text-info mb-1"><%= @pending_outbound_count %> บิล</h4>
            <%= link_to "ดูออเดอร์", orders_path, class: "btn btn-xs btn-info text-white fw-semibold py-1 px-2 fs-7" %>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<div class="row mt-4 g-4">
  <div class="col-12">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-0 py-3">
        <h5 class="mb-0 fw-bold text-dark">
          <i class="bi bi-graph-up me-2 text-primary"></i>📈 แนวโน้มยอดขายในรอบ 7 วัน (Sales Trend)
        </h5>
      </div>
      <div class="card-body">
        <%= line_chart @sales_trend,
                       xtitle: "วันที่", ytitle: "ยอดขาย (บาท)",
                       colors: ["#0d6efd"], prefix: "฿",
                       empty: "ยังไม่มีข้อมูลการขายในรอบ 7 วันนี้" %>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white border-0 py-3">
        <h5 class="mb-0 fw-bold text-dark">
          <i class="bi bi-trophy me-2 text-warning"></i>📊 5 อันดับสินค้าขายดีที่สุด (Best Sellers)
        </h5>
      </div>
      <div class="card-body">
        <%= bar_chart @top_products,
                      colors: ["#ffc107"],
                      xtitle: "จำนวนชิ้นที่ขายได้",
                      empty: "ยังไม่มีสถิติการขายสินค้า" %>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white border-0 py-3">
        <h5 class="mb-0 fw-bold text-dark">
          <i class="bi bi-pie-chart me-2 text-info"></i>🎨 สัดส่วนช่องทางการชำระเงิน (Payment Methods)
        </h5>
      </div>
      <div class="card-body d-flex align-items-center justify-content-center">
        <div style="width: 100%;">
          <%= pie_chart @payment_methods,
                        colors: ["#198754", "#0dcaf0", "#6f42c1"],
                        legend: "bottom",
                        empty: "ยังไม่มีข้อมูลการชำระเงิน" %>
        </div>
      </div>
    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartkick@5.0.1/dist/chartkick.min.js"></script>

<div class="container-fluid py-4">
