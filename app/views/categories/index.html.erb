
<div class="main-container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold text-primary">All Categories</h1>
    <%= link_to "+ New Category", new_category_path, class: "btn btn-success btn-lg shadow-sm" %>
  </div>


  <table class="table table-hover table-bordered align-middle">
    <thead class="table-light">
      <tr class="text-center">
        <th style="width: 15%;">Name</th>
        <th style="width: 60%;">Description</th>
        <th style="width: 10%;">QTY</th>
        <th style="width: 15%;" class="text-center">Management</th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td><strong><%= category.name %></strong></td>
          <td><%= category.description %></td>
          <td class="text-center">
            <span class="badge text-dark">
              <%= category.products.count %>
            </span>
          </td>
          <td class="text-center">
            <%= link_to "Edit", edit_category_path(category), class: "btn btn-sm btn-warning" %>
            <%= link_to "Delete", category_path(category), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
